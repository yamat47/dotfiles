[include]
  path = ~/.gitconfig.local
[core]
  editor = nvim
[init]
  defaultBranch = main
[pull]
  rebase = true
[push]
  autoSetupRemote = true
[fetch]
  prune = true
[rebase]
  autoSquash = true
  autoStash = true
[merge]
  conflictStyle = zdiff3
[diff]
  colorMoved = default
[commit]
  cleanup = scissors
  gpgsign = true
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
[user]
  signingkey = ~/.ssh/id_ed25519.pub
[alias]
  a          = add .
  br         = branch --verbose --verbose --color
  ca         = commit -v --amend
  cf         = commit -v --fixup=HEAD
  ci         = commit -v
  co         = checkout
  d          = diff
  ds         = diff --stat
  dmb        = !git branch --merged | egrep -v '\\*|main|master|release' | xargs git branch -d
  f          = fetch
  pf         = fetch --prune
  pl         = pull
  ps         = push
  g          = grep --line-number --show-function --color --heading --break
  l          = log --show-signature
  ls         = ls-files
  onelinelog = log --oneline
  rhs        = reset --soft HEAD~
  ri         = !sh -c 'git rebase -i HEAD~$0'
  s          = status --branch --short
  sd         = diff --staged
  sw         = switch
  swf        = !git branch -a | fzf | xargs git switch
  unstage    = reset HEAD --
  wt         = worktree
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
